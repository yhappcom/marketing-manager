{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yhappcom/marketing-manager/live_data/minttap/measurement_snapshot_v1.schema.json",
  "title": "MintTap Measurement Snapshot V1",
  "type": "object",
  "required": ["schema_version", "generated_at", "source_window", "release_scope", "source_status", "ga4", "firestore", "quality"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_window": {
      "type": "object",
      "required": ["complete_day_start", "complete_day_end", "timezone_note"],
      "properties": {
        "complete_day_start": {"type": "string", "format": "date"},
        "complete_day_end": {"type": "string", "format": "date"},
        "timezone_note": {"type": "string"},
        "partial_day_included": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "release_scope": {
      "type": "object",
      "required": ["target_release", "repository_ref"],
      "properties": {
        "target_release": {"type": "string"},
        "repository_ref": {"type": "string"},
        "platforms": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "source_status": {
      "type": "object",
      "required": ["ga4_data_api", "firestore", "bigquery"],
      "properties": {
        "ga4_data_api": {"$ref": "#/$defs/sourceState"},
        "firestore": {"$ref": "#/$defs/sourceState"},
        "bigquery": {"$ref": "#/$defs/sourceState"}
      },
      "additionalProperties": false
    },
    "ga4": {
      "type": "object",
      "required": ["event_inventory", "daily_usage", "focal_events", "ad_monetization", "version_platform"],
      "properties": {
        "event_inventory": {"type": "array", "items": {"$ref": "#/$defs/eventInventoryRow"}},
        "daily_usage": {"type": "array", "items": {"$ref": "#/$defs/dailyUsageRow"}},
        "focal_events": {"type": "array", "items": {"$ref": "#/$defs/focalEventRow"}},
        "ad_monetization": {"type": "array", "items": {"$ref": "#/$defs/adRow"}},
        "version_platform": {"type": "array", "items": {"$ref": "#/$defs/versionPlatformRow"}},
        "acquisition_optional": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    },
    "firestore": {
      "type": "object",
      "required": ["account_recency"],
      "properties": {
        "account_recency": {
          "type": "object",
          "required": ["status", "as_of", "profiles_total_readable", "profiles_with_last_active_at", "profiles_missing_last_active_at", "active_within_24h", "active_within_7d", "active_within_30d", "inactive_31_to_90d", "inactive_over_90d", "future_or_invalid_timestamp_count"],
          "properties": {
            "status": {"type": "string"},
            "as_of": {"type": "string", "format": "date-time"},
            "profiles_total_readable": {"type": ["integer", "null"], "minimum": 0},
            "profiles_with_last_active_at": {"type": ["integer", "null"], "minimum": 0},
            "profiles_missing_last_active_at": {"type": ["integer", "null"], "minimum": 0},
            "active_within_24h": {"type": ["integer", "null"], "minimum": 0},
            "active_within_7d": {"type": ["integer", "null"], "minimum": 0},
            "active_within_30d": {"type": ["integer", "null"], "minimum": 0},
            "inactive_31_to_90d": {"type": ["integer", "null"], "minimum": 0},
            "inactive_over_90d": {"type": ["integer", "null"], "minimum": 0},
            "future_or_invalid_timestamp_count": {"type": ["integer", "null"], "minimum": 0},
            "notes": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "quality": {
      "type": "object",
      "required": ["minimum_cell_size", "suppressed_segment_count", "missingness_notes", "validation_passed"],
      "properties": {
        "minimum_cell_size": {"type": "integer", "minimum": 1},
        "suppressed_segment_count": {"type": "integer", "minimum": 0},
        "missingness_notes": {"type": "array", "items": {"type": "string"}},
        "validation_passed": {"type": "boolean"},
        "query_or_method_version": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "sourceState": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {"type": "string"},
        "detail": {"type": "string"}
      },
      "additionalProperties": false
    },
    "eventInventoryRow": {
      "type": "object",
      "required": ["event_name", "app_version", "platform", "event_count", "total_users", "active_users"],
      "properties": {
        "event_name": {"type": "string"},
        "app_version": {"type": "string"},
        "platform": {"type": "string"},
        "event_count": {"type": "integer", "minimum": 0},
        "total_users": {"type": "integer", "minimum": 0},
        "active_users": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "dailyUsageRow": {
      "type": "object",
      "required": ["date", "app_version", "platform", "active_users", "new_users", "sessions", "engaged_sessions", "user_engagement_seconds"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "app_version": {"type": "string"},
        "platform": {"type": "string"},
        "active_users": {"type": "integer", "minimum": 0},
        "new_users": {"type": "integer", "minimum": 0},
        "sessions": {"type": "integer", "minimum": 0},
        "engaged_sessions": {"type": "integer", "minimum": 0},
        "user_engagement_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "focalEventRow": {
      "type": "object",
      "required": ["date", "event_name", "app_version", "platform", "event_count", "total_users", "observation_state"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "event_name": {"type": "string"},
        "app_version": {"type": "string"},
        "platform": {"type": "string"},
        "event_count": {"type": ["integer", "null"], "minimum": 0},
        "total_users": {"type": ["integer", "null"], "minimum": 0},
        "observation_state": {"type": "string"}
      },
      "additionalProperties": false
    },
    "adRow": {
      "type": "object",
      "required": ["date", "app_version", "platform", "ad_format", "ad_source_name", "ad_unit_name", "event_count", "total_ad_revenue", "revenue_currency_semantics"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "app_version": {"type": "string"},
        "platform": {"type": "string"},
        "ad_format": {"type": ["string", "null"]},
        "ad_source_name": {"type": ["string", "null"]},
        "ad_unit_name": {"type": ["string", "null"]},
        "event_count": {"type": ["integer", "null"], "minimum": 0},
        "total_ad_revenue": {"type": ["number", "null"], "minimum": 0},
        "revenue_currency_semantics": {"type": "string"}
      },
      "additionalProperties": false
    },
    "versionPlatformRow": {
      "type": "object",
      "required": ["app_version", "platform", "active_users", "new_users", "sessions"],
      "properties": {
        "app_version": {"type": "string"},
        "platform": {"type": "string"},
        "active_users": {"type": "integer", "minimum": 0},
        "new_users": {"type": "integer", "minimum": 0},
        "sessions": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}